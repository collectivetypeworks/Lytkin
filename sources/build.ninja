# Generating instance_ufos/Lytkin-Bold.ufo.json
build instance_ufos/Lytkin-Bold.ufo.json: instantiateUfo Lytkin.glyphs
  operation = instantiateUfo
  instance_name = Lytkin Bold
  fontmake_type = -g
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --instance-dir instance_ufos
# Postprocessing  with BuildSTAT
build $
    /var/folders/j6/ytk4tn9d3bs9xql1cl5ylpr80000gn/T/tmpu6mj3shm.buildStatstamp: $
    buildSTAT-postprocess ../fonts/variable/Lytkin[wght].ttf | $
    ../fonts/variable/Lytkin[wght].ttf
  stamp =  && touch $
      /var/folders/j6/ytk4tn9d3bs9xql1cl5ylpr80000gn/T/tmpu6mj3shm.buildStatstamp
  postprocess = buildStat
# Generating ../fonts/webfonts/Lytkin[wght].woff2
build ../fonts/webfonts/Lytkin[wght].woff2: compress $
    ../fonts/variable/Lytkin[wght].ttf | $
    /var/folders/j6/ytk4tn9d3bs9xql1cl5ylpr80000gn/T/tmpu6mj3shm.buildStatstamp
  operation = compress
# Generating ../fonts/webfonts/Lytkin-ExtraLight.woff2
build ../fonts/webfonts/Lytkin-ExtraLight.woff2: compress $
    ../fonts/ttf/Lytkin-ExtraLight.ttf
  operation = compress
# Generating ../fonts/webfonts/Lytkin-Light.woff2
build ../fonts/webfonts/Lytkin-Light.woff2: compress $
    ../fonts/ttf/Lytkin-Light.ttf
  operation = compress
# Generating ../fonts/webfonts/Lytkin-Regular.woff2
