build instance_ufos/Lytkin-SemiBold.ufo.json: instantiateUfo Lytkin.glyphs
  operation = instantiateUfo
  instance_name = Lytkin SemiBold
  fontmake_type = -g
  fontmake_args =  --verbose WARNING 
